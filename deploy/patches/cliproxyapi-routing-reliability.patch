+func TestSelectorForRoutingConfigPreservesSessionAffinity(t *testing.T) {
+	cfg := &config.Config{Routing: config.RoutingConfig{
+		Strategy: "fill-first", SessionAffinity: true, SessionAffinityTTL: "15m",
+	}}
+	selector := selectorForRoutingConfig(cfg)
+	sticky, ok := selector.(*coreauth.SessionAffinitySelector)
+	if !ok {
+		t.Fatalf("selector type=%T", selector)
+	}
+	defer sticky.Stop()
+}
