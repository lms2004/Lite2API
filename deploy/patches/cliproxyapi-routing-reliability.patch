+func TestPutRoutingStrategyPersistsAndAppliesImmediately(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	if errWrite := os.WriteFile(configPath, []byte("routing:\n  strategy: round-robin\n"), 0o600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+
+	cfg := &config.Config{Routing: config.RoutingConfig{Strategy: "round-robin"}}
+	manager := coreauth.NewManager(nil, &coreauth.RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(&routingSelectionTestExecutor{provider: "claude"})
+	for _, id := range []string{"b", "a"} {
+		if _, errRegister := manager.Register(context.Background(), &coreauth.Auth{ID: id, Provider: "claude"}); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+	}
+	h := NewHandler(cfg, configPath, manager)
+
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	request := httptest.NewRequest(http.MethodPut, "/v0/management/routing/strategy", strings.NewReader(`{"value":"fill-first"}`))
+	request.Header.Set("Content-Type", "application/json")
+	ctx.Request = request
+	h.PutRoutingStrategy(ctx)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+	if cfg.Routing.Strategy != "fill-first" {
+		t.Fatalf("in-memory strategy=%q", cfg.Routing.Strategy)
+	}
+	persisted, errRead := os.ReadFile(configPath)
+	if errRead != nil || !strings.Contains(string(persisted), "strategy: fill-first") {
+		t.Fatalf("persisted config=%q err=%v", persisted, errRead)
+	}
+
+	for attempt := 0; attempt < 2; attempt++ {
+		selected := ""
+		metadata := map[string]any{
+			cliproxyexecutor.SelectedAuthCallbackMetadataKey: func(id string) { selected = id },
+		}
+		if _, errExecute := manager.Execute(context.Background(), []string{"claude"}, cliproxyexecutor.Request{}, cliproxyexecutor.Options{Metadata: metadata}); errExecute != nil {
+			t.Fatal(errExecute)
+		}
+		if selected != "a" {
+			t.Fatalf("fill-first attempt %d selected %v, want a", attempt, selected)
+		}
+	}
+}
