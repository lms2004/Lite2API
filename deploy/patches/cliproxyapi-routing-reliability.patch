+func selectorForRoutingConfig(cfg *config.Config) coreauth.Selector {
+	var selector coreauth.Selector = &coreauth.RoundRobinSelector{}
+	if cfg == nil {
+		return selector
+	}
+	if strategy, _ := normalizeRoutingStrategy(cfg.Routing.Strategy); strategy == "fill-first" {
+		selector = &coreauth.FillFirstSelector{}
+	}
+	if !cfg.Routing.ClaudeCodeSessionAffinity && !cfg.Routing.SessionAffinity {
+		return selector
+	}
+	ttl := time.Hour
+	if raw := strings.TrimSpace(cfg.Routing.SessionAffinityTTL); raw != "" {
+		if parsed, errParse := time.ParseDuration(raw); errParse == nil && parsed > 0 {
+			ttl = parsed
+		}
+	}
+	return coreauth.NewSessionAffinitySelectorWithConfig(coreauth.SessionAffinityConfig{
+		Fallback: selector,
+		TTL:      ttl,
+	})
