diff --git a/sdk/cliproxy/auth/oauth_recovery.go b/sdk/cliproxy/auth/oauth_recovery.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/auth/oauth_recovery.go
@@ -0,0 +1,58 @@
+package auth
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"time"
+)
+
+func unrefreshableOAuth(auth *Auth, now time.Time) bool {
+	if auth == nil || auth.Disabled || auth.Metadata == nil || isAPIKeyAuth(auth) {
+		return false
+	}
+	switch strings.ToLower(auth.Provider) {
+	case "codex", "claude", "gemini", "antigravity", "kimi":
+	default:
+		return false
+	}
+	refresh, _ := auth.Metadata["refresh_token"].(string)
+	access, _ := auth.Metadata["access_token"].(string)
+	if strings.TrimSpace(refresh) != "" || access == "" {
+		return false
+	}
+	if statusCodeFromResult(auth.LastError) == 401 || (auth.LastError != nil && auth.LastError.Code == "reauth_required") {
+		return true
+	}
+	if expiration, ok := auth.ExpirationTime(); ok && !expiration.After(now) {
+		return true
+	}
+	// JWT expiry is a rejection hint only, never proof of authentication. Some
+	// imported credentials omit expiration metadata but retain the signed exp.
+	if len(access) > 32<<10 {
+		return false
+	}
+	parts := strings.Split(access, ".")
+	if len(parts) != 3 {
+		return false
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return false
+	}
+	var claims struct {
+		Exp int64 `json:"exp"`
+	}
+	return json.Unmarshal(payload, &claims) == nil && claims.Exp > 0 && claims.Exp <= now.Unix()
+}
+
+func markUnrefreshableOAuth(auth *Auth, now time.Time) {
+	if !unrefreshableOAuth(auth, now) {
+		return
+	}
+	auth.Status = StatusError
+	auth.StatusMessage = "reauth_required"
+	auth.Unavailable = true
+	auth.NextRetryAfter = time.Time{}
+	auth.LastError = &Error{Code: "reauth_required", Message: "expired or rejected OAuth token has no refresh token"}
+}
diff --git a/sdk/cliproxy/auth/oauth_recovery_test.go b/sdk/cliproxy/auth/oauth_recovery_test.go
