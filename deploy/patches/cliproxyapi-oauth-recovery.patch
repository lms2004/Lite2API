+func terminalOAuthRefreshError(err error) bool {
+	if err == nil {
+		return false
+	}
+	text := strings.ToLower(err.Error())
+	return strings.Contains(text, "reauth_required") || strings.Contains(text, "invalid_grant") || strings.Contains(text, "refresh_token_reused") ||
+		strings.Contains(text, "refresh token expired") || strings.Contains(text, "refresh token has expired") ||
+		strings.Contains(text, "refresh token revoked")
+}
+
+// A new token clears authorization failures only. Quota, payment, model
+// support and provider availability failures remain in effect after refresh.
+func clearRefreshedAuthorizationFailures(auth *Auth, now time.Time) {
+	if auth == nil {
+		return
+	}
+	for model, state := range auth.ModelStates {
+		if state != nil && statusCodeFromResult(state.LastError) == http.StatusUnauthorized {
+			resetModelState(state, now)
+			registry.GetGlobalRegistry().ResumeClientModel(auth.ID, model)
+		}
+	}
+	if len(auth.ModelStates) > 0 {
+		updateAggregatedAvailability(auth, now)
+	} else if statusCodeFromResult(auth.LastError) == http.StatusUnauthorized ||
+		(auth.LastError != nil && auth.LastError.Code == "reauth_required") {
+		auth.Unavailable = false
+		auth.NextRetryAfter = time.Time{}
+	}
+	if !hasModelError(auth, now) && !auth.Unavailable && !auth.Disabled {
+		auth.Status = StatusActive
+		auth.StatusMessage = ""
+	}
 }
 
