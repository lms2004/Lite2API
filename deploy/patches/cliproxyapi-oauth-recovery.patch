--- /dev/null
+++ b/sdk/cliproxy/auth/oauth_recovery_test.go
@@ -0,0 +1,91 @@
+package auth
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestForceRefreshRestoresAuthorizationWithoutClearingQuota(t *testing.T) {
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(schedulerProviderTestExecutor{provider: "claude"})
+	now := time.Now()
+	auth := &Auth{ID: "recovery", Provider: "claude", Status: StatusError, Unavailable: true,
+		LastError: &Error{HTTPStatus: 401}, NextRetryAfter: now.Add(30 * time.Minute),
+		ModelStates: map[string]*ModelState{
+			"expired": {Status: StatusError, Unavailable: true, LastError: &Error{HTTPStatus: 401}, NextRetryAfter: now.Add(30 * time.Minute)},
+			"limited": {Status: StatusError, Unavailable: true, LastError: &Error{HTTPStatus: 429}, NextRetryAfter: now.Add(time.Hour), Quota: QuotaState{Exceeded: true, NextRecoverAt: now.Add(time.Hour)}},
+		}}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatal(err)
+	}
+	updated, err := manager.ForceRefreshAuth(context.Background(), auth.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if blocked, _, _ := isAuthBlockedForModel(updated, "expired", now); blocked {
+		t.Fatal("refreshed authorization is still blocked")
+	}
+	if !updated.ModelStates["limited"].Quota.Exceeded {
+		t.Fatal("token refresh cleared a genuine quota limit")
+	}
+	if blocked, _, _ := isAuthBlockedForModel(updated, "limited", now); !blocked {
+		t.Fatal("quota-limited model became selectable")
+	}
+}
+
+func TestExpiredAccessOnlyCredentialCannotReportSuccessfulRefresh(t *testing.T) {
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(schedulerProviderTestExecutor{provider: "codex"})
+	payload := base64.RawURLEncoding.EncodeToString([]byte(`{"exp":1}`))
+	auth := &Auth{ID: "expired-access-only", Provider: "codex", Status: StatusActive,
+		Metadata: map[string]any{"access_token": "header." + payload + ".signature", "refresh_token": ""}}
+	registered, err := manager.Register(context.Background(), auth)
+	if err != nil || registered.LastError == nil || registered.LastError.Code != "reauth_required" {
+		t.Fatalf("expired imported credential was advertised as usable: %+v %v", registered, err)
+	}
+	if _, err := manager.ForceRefreshAuth(context.Background(), auth.ID); err == nil {
+		t.Fatal("no-op refresh was reported as success")
+	}
+	future := base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, time.Now().Add(time.Hour).Unix())))
+	fresh := &Auth{Provider: "codex", Metadata: map[string]any{"access_token": "header." + future + ".signature"}}
+	if unrefreshableOAuth(fresh, time.Now()) {
+		t.Fatal("valid temporary access-only token was prematurely rejected")
+	}
+}
+
+type terminalRefreshExecutor struct{ schedulerProviderTestExecutor }
+
+func (e terminalRefreshExecutor) Refresh(context.Context, *Auth) (*Auth, error) {
+	return nil, errors.New(`{"error":"invalid_grant","error_description":"Refresh token expired"}`)
+}
+
+func TestTerminalRefreshRequiresReauthorizationAndCanRecover(t *testing.T) {
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(terminalRefreshExecutor{schedulerProviderTestExecutor{provider: "claude"}})
+	auth := &Auth{ID: "terminal-refresh", Provider: "claude", Status: StatusActive}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manager.ForceRefreshAuth(context.Background(), auth.ID); err == nil {
+		t.Fatal("expected failed refresh")
+	}
+	failed, _ := manager.GetByID(auth.ID)
+	if failed.LastError.Code != "reauth_required" || failed.StatusMessage != "reauth_required" {
+		t.Fatalf("missing actionable failure status: %+v", failed)
+	}
+	if manager.shouldRefresh(failed, time.Now().Add(24*time.Hour)) {
+		t.Fatal("terminal refresh would be retried automatically")
+	}
+	if blocked, _, _ := isAuthBlockedForModel(failed, "another-model", time.Now()); !blocked {
+		t.Fatal("terminal credential was selectable for an unobserved model")
+	}
+	manager.RegisterExecutor(schedulerProviderTestExecutor{provider: "claude"})
+	updated, err := manager.ForceRefreshAuth(context.Background(), auth.ID)
+	if err != nil || updated.Status != StatusActive || updated.LastError != nil || updated.Unavailable {
+		t.Fatalf("manual reauthorization did not recover: updated=%+v err=%v", updated, err)
+	}
+}
