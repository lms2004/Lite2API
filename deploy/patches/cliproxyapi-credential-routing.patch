+package api
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v6/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v6/sdk/cliproxy/auth"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v6/sdk/config"
+)
+
+func TestCredentialRoutingMiddlewareAcceptsPublicIndexAndStripsHeaders(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	manager := coreauth.NewManager(nil, nil, nil)
+	registered, err := manager.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{
+		ID: "internal-auth-id", Provider: "antigravity", FileName: "account.json",
+	})
+	if err != nil {
+		t.Fatalf("register auth: %v", err)
+	}
+	publicIndex := registered.EnsureIndex()
+	server := &Server{handlers: handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)}
+
+	engine := gin.New()
+	engine.Use(server.credentialRoutingMiddleware())
+	var pinHeader, selectedHeader string
+	engine.POST("/", func(c *gin.Context) {
+		pinHeader = c.GetHeader(lite2APIPinnedAuthIndexHeader)
+		selectedHeader = c.GetHeader(lite2APISelectedAuthIndexHeader)
+		c.Status(http.StatusNoContent)
+	})
+
+	request := httptest.NewRequest(http.MethodPost, "/", nil)
+	request.Header.Set(lite2APIPinnedAuthIndexHeader, publicIndex)
+	request.Header.Set(lite2APISelectedAuthIndexHeader, "spoofed")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if recorder.Code != http.StatusNoContent {
+		t.Fatalf("status = %d, want %d; body=%s", recorder.Code, http.StatusNoContent, recorder.Body.String())
+	}
+	if pinHeader != "" || selectedHeader != "" {
+		t.Fatalf("internal headers reached handler: pin=%q selected=%q", pinHeader, selectedHeader)
+	}
+}
+
+func TestCredentialRoutingMiddlewareRejectsUnknownPublicIndex(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	manager := coreauth.NewManager(nil, nil, nil)
+	server := &Server{handlers: handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)}
+	engine := gin.New()
+	engine.Use(server.credentialRoutingMiddleware())
+	engine.POST("/", func(c *gin.Context) { c.Status(http.StatusNoContent) })
+
+	request := httptest.NewRequest(http.MethodPost, "/", nil)
+	request.Header.Set(lite2APIPinnedAuthIndexHeader, "0123456789abcdef")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if recorder.Code != http.StatusServiceUnavailable || !strings.Contains(recorder.Body.String(), "credential_not_found") {
+		t.Fatalf("unexpected response: status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+}
+
+func TestSelectedAuthIndexCallbackPublishesLatestStablePublicIndex(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	first, err := manager.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{
+		ID: "internal-first", Provider: "antigravity", FileName: "first.json",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := manager.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{
+		ID: "internal-second", Provider: "antigravity", FileName: "second.json",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	header := make(http.Header)
+	callback := selectedAuthIndexCallback(manager, header)
+	callback(first.ID)
+	callback(second.ID)
+	if got := header.Get(lite2APISelectedAuthIndexHeader); got != second.EnsureIndex() {
+		t.Fatalf("selected auth index = %q, want %q", got, second.EnsureIndex())
+	}
+}
