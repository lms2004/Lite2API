+// credentialRoutingMiddleware translates Lite2API's stable public auth index
+// into the internal auth ID understood by the execution manager. The inbound
+// routing headers are always removed before provider handlers inspect headers.
+func (s *Server) credentialRoutingMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		requestedIndex := strings.TrimSpace(c.GetHeader(lite2APIPinnedAuthIndexHeader))
+		c.Request.Header.Del(lite2APIPinnedAuthIndexHeader)
+		c.Request.Header.Del(lite2APISelectedAuthIndexHeader)
+
+		if s == nil || s.handlers == nil || s.handlers.AuthManager == nil {
+			if requestedIndex != "" {
+				c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": gin.H{"message": "credential routing is unavailable", "type": "server_error", "code": "credential_routing_unavailable"}})
+				return
+			}
+			c.Next()
+			return
+		}
+
+		manager := s.handlers.AuthManager
+		requestContext := c.Request.Context()
+		requestContext = handlers.WithSelectedAuthIDCallback(requestContext, selectedAuthIndexCallback(manager, c.Writer.Header()))
+
+		if requestedIndex != "" {
+			internalID := ""
+			for _, candidate := range manager.List() {
+				if candidate != nil && strings.TrimSpace(candidate.EnsureIndex()) == requestedIndex {
+					internalID = strings.TrimSpace(candidate.ID)
+					break
+				}
+			}
+			if internalID == "" {
+				c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": gin.H{"message": "requested credential is not present", "type": "server_error", "code": "credential_not_found"}})
+				return
+			}
+			requestContext = handlers.WithPinnedAuthID(requestContext, internalID)
+		}
+
+		c.Request = c.Request.WithContext(requestContext)
+		c.Next()
+	}
+}
+
+func selectedAuthIndexCallback(manager *auth.Manager, responseHeader http.Header) func(string) {
+	return func(authID string) {
+		if manager == nil || responseHeader == nil {
+			return
+		}
+		selected, ok := manager.GetByID(strings.TrimSpace(authID))
+		if !ok || selected == nil {
+			return
+		}
+		if publicIndex := strings.TrimSpace(selected.EnsureIndex()); publicIndex != "" {
+			responseHeader.Set(lite2APISelectedAuthIndexHeader, publicIndex)
+		}
+	}
+}
