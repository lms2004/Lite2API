+package handlers
+
+import (
+	"context"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v6/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v6/sdk/config"
+)
+
+type credentialRoutingTestHandler struct{}
+
+func (credentialRoutingTestHandler) HandlerType() string      { return "test" }
+func (credentialRoutingTestHandler) Models() []map[string]any { return nil }
+
+func TestGetContextWithCancelPropagatesCredentialRoutingMetadata(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	ginContext, _ := gin.CreateTestContext(recorder)
+
+	selected := ""
+	requestContext := WithPinnedAuthID(context.Background(), "internal-auth-id")
+	requestContext = WithSelectedAuthIDCallback(requestContext, func(authID string) {
+		selected = authID
+	})
+	request := httptest.NewRequest("POST", "/v1/chat/completions", nil)
+	ginContext.Request = request.WithContext(requestContext)
+
+	handler := &BaseAPIHandler{Cfg: &sdkconfig.SDKConfig{}}
+	executionContext, cancel := handler.GetContextWithCancel(credentialRoutingTestHandler{}, ginContext, context.Background())
+	defer cancel()
+	metadata := requestExecutionMetadata(executionContext)
+
+	if got, _ := metadata[executor.PinnedAuthMetadataKey].(string); got != "internal-auth-id" {
+		t.Fatalf("pinned auth metadata = %q, want internal-auth-id", got)
+	}
+	callback, ok := metadata[executor.SelectedAuthCallbackMetadataKey].(func(string))
+	if !ok || callback == nil {
+		t.Fatal("selected auth callback was not propagated")
+	}
+	callback("selected-auth-id")
+	if selected != "selected-auth-id" {
+		t.Fatalf("selected auth callback received %q", selected)
+	}
+}
