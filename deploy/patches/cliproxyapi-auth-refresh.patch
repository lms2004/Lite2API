+// RefreshAuthFiles forces credential refresh for one or more auth files.
+func (h *Handler) RefreshAuthFiles(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "core auth manager unavailable"})
+		return
+	}
+
+	names, all, errNames := requestedAuthFileNamesForRefresh(c)
+	if errNames != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": errNames.Error()})
+		return
+	}
+
+	targets := make([]*coreauth.Auth, 0)
+	if all || len(names) == 0 {
+		targets = h.authManager.List()
+	} else {
+		missing := make([]string, 0)
+		for _, name := range names {
+			auth := h.findAuthByNameOrID(name)
+			if auth == nil {
+				missing = append(missing, name)
+				continue
+			}
+			targets = append(targets, auth)
+		}
+		if len(missing) > 0 {
+			c.JSON(http.StatusNotFound, gin.H{"error": "auth file not found", "missing": missing})
+			return
+		}
+	}
+
+	uniqueTargets := make([]*coreauth.Auth, 0, len(targets))
+	seen := make(map[string]struct{}, len(targets))
+	for _, auth := range targets {
+		if auth == nil || strings.TrimSpace(auth.ID) == "" {
+			continue
+		}
+		if _, ok := seen[auth.ID]; ok {
+			continue
+		}
+		seen[auth.ID] = struct{}{}
+		uniqueTargets = append(uniqueTargets, auth)
+	}
+
+	type refreshResult struct {
+		updated *coreauth.Auth
+		err     error
+		skipped bool
+	}
+	results := make([]refreshResult, len(uniqueTargets))
+	workers := authRefreshWorkers
+	if len(uniqueTargets) < workers {
+		workers = len(uniqueTargets)
+	}
+	if workers > 0 {
+		ctx := c.Request.Context()
+		jobs := make(chan int)
+		var wait sync.WaitGroup
+		wait.Add(workers)
+		for worker := 0; worker < workers; worker++ {
+			go func() {
+				defer wait.Done()
+				for index := range jobs {
+					auth := uniqueTargets[index]
+					if auth.Disabled || auth.Status == coreauth.StatusDisabled {
+						results[index].skipped = true
+						continue
+					}
+					results[index].updated, results[index].err = h.authManager.ForceRefreshAuth(ctx, auth.ID)
+				}
+			}()
+		}
+		for index := range uniqueTargets {
+			jobs <- index
+		}
+		close(jobs)
+		wait.Wait()
+	}
+
+	refreshed := make([]gin.H, 0, len(uniqueTargets))
+	failed := make([]gin.H, 0)
+	skipped := make([]gin.H, 0)
+	for index, auth := range uniqueTargets {
+		entry := authFileRefreshEntry(auth)
+		if results[index].skipped {
+			entry["reason"] = "disabled"
+			skipped = append(skipped, entry)
+			continue
+		}
+		if results[index].err != nil {
+			entry["error"] = results[index].err.Error()
+			failed = append(failed, entry)
+			continue
+		}
+		refreshed = append(refreshed, authFileRefreshEntry(results[index].updated))
+	}
+
+	status := http.StatusOK
+	responseStatus := "ok"
+	if len(failed) > 0 {
+		status = http.StatusMultiStatus
+		responseStatus = "partial"
+	}
+	c.JSON(status, gin.H{
+		"status":    responseStatus,
+		"refreshed": len(refreshed),
+		"skipped":   len(skipped),
+		"files":     refreshed,
+		"failed":    failed,
+	})
+}
+
+func authFileRefreshEntry(auth *coreauth.Auth) gin.H {
+	entry := gin.H{}
+	if auth == nil {
+		return entry
+	}
+	auth.EnsureIndex()
+	entry["id"] = auth.ID
+	entry["auth_index"] = auth.Index
+	if name := strings.TrimSpace(auth.FileName); name != "" {
+		entry["name"] = name
+	}
+	if provider := strings.TrimSpace(auth.Provider); provider != "" {
+		entry["provider"] = provider
+	}
+	return entry
+}
+
+func requestedAuthFileNamesForRefresh(c *gin.Context) ([]string, bool, error) {
+	if c == nil {
+		return nil, false, nil
+	}
+	names := uniqueAuthFileNames(append(c.QueryArray("name"), c.QueryArray("names")...))
+	all := queryBool(c.Query("all"))
+	if len(names) > 0 || all {
+		return names, all, nil
+	}
+
+	body, err := io.ReadAll(c.Request.Body)
+	if err != nil {
+		return nil, false, fmt.Errorf("failed to read body")
+	}
+	body = bytes.TrimSpace(body)
+	if len(body) == 0 {
+		return nil, false, nil
+	}
+
+	if body[0] == '[' {
+		var arrayBody []string
+		if err := json.Unmarshal(body, &arrayBody); err != nil {
+			return nil, false, fmt.Errorf("invalid request body")
+		}
+		return uniqueAuthFileNames(arrayBody), false, nil
+	}
+
+	var objectBody struct {
+		Name  string   `json:"name"`
+		Names []string `json:"names"`
+		All   bool     `json:"all"`
+	}
+	if err := json.Unmarshal(body, &objectBody); err != nil {
+		return nil, false, fmt.Errorf("invalid request body")
+	}
+	out := make([]string, 0, len(objectBody.Names)+1)
+	if strings.TrimSpace(objectBody.Name) != "" {
+		out = append(out, objectBody.Name)
+	}
+	out = append(out, objectBody.Names...)
+	return uniqueAuthFileNames(out), objectBody.All, nil
+}
+
+func queryBool(raw string) bool {
+	switch strings.ToLower(strings.TrimSpace(raw)) {
+	case "1", "true", "yes", "on", "*":
+		return true
+	default:
+		return false
+	}
+}
+
+func (h *Handler) findAuthByNameOrID(name string) *coreauth.Auth {
+	if h == nil || h.authManager == nil {
+		return nil
+	}
+	name = strings.TrimSpace(name)
+	if name == "" {
+		return nil
+	}
+	if auth, ok := h.authManager.GetByID(name); ok {
+		return auth
+	}
+	for _, auth := range h.authManager.List() {
+		if auth == nil {
+			continue
+		}
+		auth.EnsureIndex()
+		if strings.TrimSpace(auth.ID) == name || strings.TrimSpace(auth.Index) == name || strings.TrimSpace(auth.FileName) == name {
+			return auth
+		}
+		if filepath.Base(strings.TrimSpace(authAttribute(auth, "path"))) == name {
+			return auth
+		}
+	}
+	return nil
+}
