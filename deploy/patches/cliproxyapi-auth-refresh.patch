+func (e *authFileRefreshTestExecutor) Refresh(ctx context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	e.calls.Add(1)
+	inFlight := e.inFlight.Add(1)
+	defer e.inFlight.Add(-1)
+	for current := e.maxInFlight.Load(); inFlight > current && !e.maxInFlight.CompareAndSwap(current, inFlight); current = e.maxInFlight.Load() {
+	}
+	if e.started != nil {
+		select {
+		case e.started <- struct{}{}:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	if e.release != nil {
+		select {
+		case <-e.release:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	if auth.Metadata == nil {
+		auth.Metadata = make(map[string]any)
+	}
