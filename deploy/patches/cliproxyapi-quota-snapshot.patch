+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestParseQuotaWindowsClaude(t *testing.T) {
+	now := time.Date(2026, 8, 16, 1, 2, 3, 0, time.UTC)
+	headers := http.Header{
+		"Anthropic-Ratelimit-Unified-5h-Utilization":      []string{"0.7246"},
+		"Anthropic-Ratelimit-Unified-5h-Reset":            []string{"1786845600"},
+		"Anthropic-Ratelimit-Unified-7d-Utilization":      []string{"18.5"},
+		"Anthropic-Ratelimit-Unified-7d-Reset":            []string{"2026-08-20T08:00:00Z"},
+		"Anthropic-Ratelimit-Unified-7d-Opus-Utilization": []string{"not-a-number"},
+		"Authorization": []string{"Bearer secret"},
+	}
+	windows := ParseQuotaWindows("claude", headers, now)
+	if len(windows) != 2 {
+		t.Fatalf("windows=%+v", windows)
+	}
+	byKind := make(map[string]QuotaWindow, len(windows))
+	for _, window := range windows {
+		byKind[window.Kind] = window
+	}
+	if got := byKind["five_hour"].UsedPercentage; got == nil || *got != 72.46 {
+		t.Fatalf("five_hour used=%v", got)
+	}
+	if got := byKind["seven_day"].UsedPercentage; got == nil || *got != 18.5 {
+		t.Fatalf("seven_day used=%v", got)
+	}
+	if byKind["five_hour"].ObservedAt != now || byKind["five_hour"].Source != "provider_response" {
+		t.Fatalf("unexpected metadata: %+v", byKind["five_hour"])
+	}
+}
+
+func TestManagerObservesAndPreservesQuotaWindows(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	if _, err := manager.Register(context.Background(), &Auth{ID: "claude-account", Provider: "claude", Status: StatusActive}); err != nil {
+		t.Fatal(err)
+	}
+	manager.observeQuotaHeaders("claude-account", "claude", http.Header{
+		"Anthropic-Ratelimit-Unified-5h-Utilization": []string{"0.91"},
+	})
+	observed, ok := manager.GetByID("claude-account")
+	if !ok || len(observed.QuotaWindows) != 1 || observed.QuotaWindows[0].UsedPercentage == nil || *observed.QuotaWindows[0].UsedPercentage != 91 {
+		t.Fatalf("unexpected observed quota: %+v", observed)
+	}
+	if _, err := manager.Update(context.Background(), &Auth{ID: "claude-account", Provider: "claude", Status: StatusActive}); err != nil {
+		t.Fatal(err)
+	}
+	updated, _ := manager.GetByID("claude-account")
+	if len(updated.QuotaWindows) != 1 || updated.QuotaWindows[0].UsedPercentage == nil || *updated.QuotaWindows[0].UsedPercentage != 91 {
+		t.Fatalf("quota lost after active credential update: %+v", updated.QuotaWindows)
+	}
+}
+
+func TestQuotaWindowsAreNeverPersistedWithAuth(t *testing.T) {
+	payload, err := json.Marshal(&Auth{
+		ID: "claude-account",
+		QuotaWindows: []QuotaWindow{{
+			Kind: "five_hour", UsedPercentage: float64Pointer(12.5), ObservedAt: time.Now(), Source: "provider_response",
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(payload), "quota_windows") || strings.Contains(string(payload), "five_hour") {
+		t.Fatalf("runtime quota snapshot leaked into persisted auth JSON: %s", payload)
+	}
+}
+
+func TestParseQuotaWindowsIgnoresUnknownProviderAndInvalidValues(t *testing.T) {
+	headers := http.Header{"Anthropic-Ratelimit-Unified-5h-Utilization": []string{"-1"}}
+	if got := ParseQuotaWindows("gemini", headers, time.Now()); got != nil {
+		t.Fatalf("unexpected gemini windows: %+v", got)
+	}
+	if got := ParseQuotaWindows("claude", headers, time.Now()); got != nil {
+		t.Fatalf("unexpected invalid windows: %+v", got)
+	}
+}
