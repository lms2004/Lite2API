@@ -0,0 +1,62 @@
+package auth
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+// PromptUsageSnapshot is the latest provider-reported token usage for one
+// credential. It is deliberately runtime-only: raw prompts, responses and
+// credential material never enter this snapshot or the auth file.
+type PromptUsageSnapshot struct {
+	Provider        string    `json:"provider,omitempty"`
+	Model           string    `json:"model,omitempty"`
+	InputTokens     int64     `json:"input_tokens"`
+	OutputTokens    int64     `json:"output_tokens"`
+	ReasoningTokens int64     `json:"reasoning_tokens"`
+	CachedTokens    int64     `json:"cached_tokens"`
+	TotalTokens     int64     `json:"total_tokens"`
+	ObservedAt      time.Time `json:"observed_at"`
+	Source          string    `json:"source"`
+	LatencyMS       int64     `json:"latency_ms,omitempty"`
+}
+
+var promptUsageSnapshots sync.Map // map[string]PromptUsageSnapshot
+
+// SetPromptUsageSnapshot replaces the latest non-empty usage observation for
+// one credential. The data is process-local and intentionally not persisted.
+func SetPromptUsageSnapshot(authID string, snapshot PromptUsageSnapshot) {
+	authID = strings.TrimSpace(authID)
+	if authID == "" || !validPromptUsageSnapshot(snapshot) {
+		return
+	}
+	if snapshot.ObservedAt.IsZero() {
+		snapshot.ObservedAt = time.Now().UTC()
+	} else {
+		snapshot.ObservedAt = snapshot.ObservedAt.UTC()
+	}
+	promptUsageSnapshots.Store(authID, snapshot)
+}
+
+func validPromptUsageSnapshot(snapshot PromptUsageSnapshot) bool {
+	if snapshot.InputTokens < 0 || snapshot.OutputTokens < 0 || snapshot.ReasoningTokens < 0 || snapshot.CachedTokens < 0 || snapshot.TotalTokens < 0 {
+		return false
+	}
+	return snapshot.InputTokens > 0 || snapshot.OutputTokens > 0 || snapshot.ReasoningTokens > 0 || snapshot.CachedTokens > 0 || snapshot.TotalTokens > 0
+}
+
+// PromptUsageSnapshotForAuth returns the latest runtime-only observation.
+func PromptUsageSnapshotForAuth(authID string) (PromptUsageSnapshot, bool) {
+	value, ok := promptUsageSnapshots.Load(strings.TrimSpace(authID))
+	if !ok {
+		return PromptUsageSnapshot{}, false
+	}
+	snapshot, ok := value.(PromptUsageSnapshot)
+	return snapshot, ok
+}
+
+// ClearPromptUsageSnapshot drops runtime usage when a credential is removed.
+func ClearPromptUsageSnapshot(authID string) {
+	promptUsageSnapshots.Delete(strings.TrimSpace(authID))
+}
