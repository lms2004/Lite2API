diff --git a/internal/api/handlers/management/quota_refresh.go b/internal/api/handlers/management/quota_refresh.go
new file mode 100644
index 0000000..ab19168
--- /dev/null
+++ b/internal/api/handlers/management/quota_refresh.go
@@ -0,0 +1,334 @@
+package management
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v6/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+const (
+	quotaRefreshTTL     = 10 * time.Minute
+	quotaRefreshTimeout = 6 * time.Second
+	maxQuotaWindows     = 16
+)
+
+func (h *Handler) scheduleQuotaRefresh(auths []*coreauth.Auth) {
+	if h == nil || h.authManager == nil {
+		return
+	}
+	now := time.Now()
+	for _, auth := range auths {
+		if auth == nil || auth.Disabled {
+			continue
+		}
+		provider := strings.ToLower(strings.TrimSpace(auth.Provider))
+		if provider != "codex" && provider != "gemini" && provider != "gemini-cli" && provider != "antigravity" {
+			continue
+		}
+		h.mu.Lock()
+		due := now.Sub(h.quotaRefreshAt[auth.ID]) >= quotaRefreshTTL && !h.quotaRefreshRunning[auth.ID]
+		if due {
+			h.quotaRefreshRunning[auth.ID] = true
+		}
+		h.mu.Unlock()
+		if !due {
+			continue
+		}
+		copyAuth := auth.Clone()
+		go h.refreshProviderQuota(copyAuth)
+	}
+}
+
+func (h *Handler) refreshProviderQuota(auth *coreauth.Auth) {
+	if auth == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), quotaRefreshTimeout)
+	defer cancel()
+	provider := strings.ToLower(strings.TrimSpace(auth.Provider))
+	var (
+		windows []coreauth.QuotaWindow
+		err     error
+	)
+	if provider == "codex" {
+		windows, err = h.fetchCodexQuota(ctx, auth)
+	} else {
+		windows, err = h.fetchGoogleQuota(ctx, auth)
+	}
+	h.mu.Lock()
+	h.quotaRefreshRunning[auth.ID] = false
+	// Successful empty responses are cached too. Errors retry after one minute,
+	// avoiding a failing request on every 15-second UI refresh.
+	if err == nil {
+		h.quotaRefreshAt[auth.ID] = time.Now()
+	} else {
+		h.quotaRefreshAt[auth.ID] = time.Now().Add(-quotaRefreshTTL + time.Minute)
+	}
+	h.mu.Unlock()
+	if err != nil {
+		log.WithError(err).Debugf("quota snapshot refresh failed for %s (%s)", auth.ID, provider)
+		return
+	}
+	if len(windows) > 0 && h.authManager != nil {
+		h.authManager.SetQuotaWindows(auth.ID, windows)
+	}
+}
+
+func (h *Handler) fetchCodexQuota(ctx context.Context, auth *coreauth.Auth) ([]coreauth.QuotaWindow, error) {
+	token := metadataString(auth, "access_token")
+	if token == "" || strings.TrimSpace(authAttribute(auth, "api_key")) != "" {
+		return nil, fmt.Errorf("chatgpt OAuth credential required")
+	}
+	usageURL := "https://chatgpt.com/backend-api/wham/usage"
+	if configured := strings.TrimSpace(authAttribute(auth, "base_url")); configured != "" {
+		if idx := strings.Index(configured, "/backend-api/"); idx >= 0 {
+			usageURL = strings.TrimRight(configured[:idx], "/") + "/backend-api/wham/usage"
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, usageURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "codex_cli_rs/0.118.0")
+	if accountID := metadataString(auth, "account_id"); accountID != "" {
+		req.Header.Set("ChatGPT-Account-ID", accountID)
+	}
+	body, err := h.doQuotaRequest(req, auth)
+	if err != nil {
+		return nil, err
+	}
+	return parseCodexQuota(body, time.Now()), nil
+}
+
+func (h *Handler) fetchGoogleQuota(ctx context.Context, auth *coreauth.Auth) ([]coreauth.QuotaWindow, error) {
+	token := metadataString(auth, "access_token")
+	project := metadataString(auth, "project_id")
+	if token == "" || project == "" {
+		return nil, fmt.Errorf("google OAuth token and project are required")
+	}
+	// Multi-project Gemini credentials use the first onboarded project only for
+	// quota discovery; quota is account-scoped, so querying every project wastes resources.
+	project = strings.TrimSpace(strings.Split(project, ",")[0])
+	payload, err := json.Marshal(map[string]string{"project": project})
+	if err != nil {
+		return nil, err
+	}
+	endpoint := "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota"
+	userAgent := "gemini-cli"
+	if strings.EqualFold(auth.Provider, "antigravity") {
+		endpoint = "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota"
+		userAgent = "antigravity/1.21.9 darwin/arm64"
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(payload))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", userAgent)
+	body, err := h.doQuotaRequest(req, auth)
+	if err != nil {
+		return nil, err
+	}
+	return parseGoogleQuota(body, time.Now()), nil
+}
+
+func (h *Handler) doQuotaRequest(req *http.Request, auth *coreauth.Auth) ([]byte, error) {
+	client := &http.Client{Timeout: quotaRefreshTimeout, Transport: h.apiCallTransport(auth)}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("quota endpoint returned HTTP %d", resp.StatusCode)
+	}
+	return body, nil
+}
+
+func parseCodexQuota(body []byte, observedAt time.Time) []coreauth.QuotaWindow {
+	windows := make([]coreauth.QuotaWindow, 0, 6)
+	appendWindow := func(prefix, label, path string) {
+		node := gjson.GetBytes(body, path)
+		if !node.Exists() {
+			return
+		}
+		used, ok := finitePercentage(node.Get("used_percent"))
+		if !ok {
+			return
+		}
+		durationSeconds := node.Get("limit_window_seconds").Int()
+		if durationSeconds == 0 {
+			durationSeconds = node.Get("window_minutes").Int() * 60
+		}
+		kind := prefix
+		if durationSeconds == 5*60*60 {
+			kind, label = "five_hour", "5 小时"
+		} else if durationSeconds == 7*24*60*60 {
+			kind, label = "seven_day", "7 天"
+		}
+		windows = append(windows, coreauth.QuotaWindow{Kind: kind, Label: label, UsedPercentage: floatPointer(used), ResetAt: quotaReset(node.Get("reset_at")), ObservedAt: observedAt.UTC(), Source: "provider_quota_api"})
+	}
+	appendWindow("codex_primary", "主额度", "rate_limit.primary_window")
+	appendWindow("codex_secondary", "次额度", "rate_limit.secondary_window")
+	appendWindow("code_review_primary", "代码审查", "code_review_rate_limit.primary_window")
+	appendWindow("code_review_secondary", "代码审查周额度", "code_review_rate_limit.secondary_window")
+	if len(windows) == 0 {
+		appendWindow("codex_primary", "主额度", "rate_limits.primary")
+		appendWindow("codex_secondary", "次额度", "rate_limits.secondary")
+	}
+	return windows
+}
+
+func parseGoogleQuota(body []byte, observedAt time.Time) []coreauth.QuotaWindow {
+	buckets := gjson.GetBytes(body, "buckets")
+	if !buckets.IsArray() {
+		return nil
+	}
+	windows := make([]coreauth.QuotaWindow, 0, len(buckets.Array()))
+	for _, bucket := range buckets.Array() {
+		model := strings.TrimSpace(bucket.Get("modelId").String())
+		if strings.HasPrefix(model, "chat_") || strings.HasPrefix(model, "tab_") {
+			continue
+		}
+		remainingFraction := bucket.Get("remainingFraction")
+		fraction, ok := finiteNumber(remainingFraction)
+		if !ok || fraction < 0 {
+			continue
+		}
+		if fraction > 1 {
+			fraction = 1
+		}
+		used := math.Round((1-fraction)*10000) / 100
+		window := coreauth.QuotaWindow{Kind: "model_quota", Model: model, Label: strings.TrimSpace(bucket.Get("tokenType").String()), UsedPercentage: floatPointer(used), ResetAt: quotaReset(bucket.Get("resetTime")), ObservedAt: observedAt.UTC(), Source: "provider_quota_api"}
+		if remaining, okRemaining := finiteNumber(bucket.Get("remainingAmount")); okRemaining {
+			window.Remaining = floatPointer(remaining)
+			window.Unit = "requests"
+		}
+		windows = append(windows, window)
+	}
+	sort.SliceStable(windows, func(i, j int) bool {
+		if *windows[i].UsedPercentage != *windows[j].UsedPercentage {
+			return *windows[i].UsedPercentage > *windows[j].UsedPercentage
+		}
+		return windows[i].Model < windows[j].Model
+	})
+	if len(windows) > maxQuotaWindows {
+		windows = windows[:maxQuotaWindows]
+	}
+	return windows
+}
+
+func quotaWindowsForAuth(auth *coreauth.Auth) []coreauth.QuotaWindow {
+	if auth == nil {
+		return nil
+	}
+	windows := make([]coreauth.QuotaWindow, 0, len(auth.QuotaWindows)+4)
+	now := time.Now().UTC()
+	// Put active cooldowns first so a long provider model list cannot hide the
+	// state that currently affects routing.
+	for model, state := range auth.ModelStates {
+		if state == nil || (!state.Quota.Exceeded && state.NextRetryAfter.IsZero() && state.Quota.NextRecoverAt.IsZero()) {
+			continue
+		}
+		resetAt := state.Quota.NextRecoverAt
+		if resetAt.IsZero() {
+			resetAt = state.NextRetryAfter
+		}
+		var reset *time.Time
+		if !resetAt.IsZero() {
+			value := resetAt.UTC()
+			reset = &value
+		}
+		observed := state.UpdatedAt.UTC()
+		if observed.IsZero() {
+			observed = now
+		}
+		windows = append(windows, coreauth.QuotaWindow{Kind: "model_cooldown", Model: model, Label: "模型冷却", Status: "cooldown", ResetAt: reset, ObservedAt: observed, Source: "provider_error"})
+	}
+	if strings.EqualFold(auth.Provider, "antigravity") {
+		if hint, ok := coreauth.GetAntigravityCreditsHint(auth.ID); ok && hint.Known {
+			status := "available"
+			if !hint.Available {
+				status = "exhausted"
+			}
+			windows = append(windows, coreauth.QuotaWindow{Kind: "credits", Label: "AI Credits", Remaining: floatPointer(hint.CreditAmount), Unit: "credits", Status: status, ObservedAt: hint.UpdatedAt.UTC(), Source: "provider_account_api"})
+		}
+	}
+	windows = append(windows, auth.QuotaWindows...)
+	if len(windows) > maxQuotaWindows {
+		windows = windows[:maxQuotaWindows]
+	}
+	return windows
+}
+
+func metadataString(auth *coreauth.Auth, key string) string {
+	if auth == nil || auth.Metadata == nil {
+		return ""
+	}
+	value, _ := auth.Metadata[key].(string)
+	return strings.TrimSpace(value)
+}
+
+func finitePercentage(value gjson.Result) (float64, bool) {
+	number, ok := finiteNumber(value)
+	if !ok || number < 0 {
+		return 0, false
+	}
+	if number > 100 {
+		number = 100
+	}
+	return math.Round(number*100) / 100, true
+}
+
+func finiteNumber(value gjson.Result) (float64, bool) {
+	if !value.Exists() {
+		return 0, false
+	}
+	raw := strings.TrimSpace(value.String())
+	if raw == "" {
+		return 0, false
+	}
+	number, err := strconv.ParseFloat(raw, 64)
+	if err != nil || math.IsNaN(number) || math.IsInf(number, 0) {
+		return 0, false
+	}
+	return number, true
+}
+
+func quotaReset(value gjson.Result) *time.Time {
+	if !value.Exists() {
+		return nil
+	}
+	raw := strings.TrimSpace(value.String())
+	if unix, err := strconv.ParseInt(raw, 10, 64); err == nil && unix > 0 {
+		parsed := time.Unix(unix, 0).UTC()
+		return &parsed
+	}
+	if parsed, err := time.Parse(time.RFC3339, raw); err == nil {
+		utc := parsed.UTC()
+		return &utc
+	}
+	return nil
+}
+
+func floatPointer(value float64) *float64 { return &value }
