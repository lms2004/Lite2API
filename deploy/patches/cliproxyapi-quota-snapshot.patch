+package management
+
+import (
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v6/sdk/cliproxy/auth"
+)
+
+func TestParseCodexQuota(t *testing.T) {
+	now := time.Date(2026, 8, 16, 2, 0, 0, 0, time.UTC)
+	windows := parseCodexQuota([]byte(`{
+		"rate_limit": {
+			"primary_window": {"used_percent": 42, "limit_window_seconds": 18000, "reset_at": 1786849200},
+			"secondary_window": {"used_percent": 7.5, "limit_window_seconds": 604800, "reset_at": 1787454000}
+		}
+	}`), now)
+	if len(windows) != 2 {
+		t.Fatalf("windows = %+v", windows)
+	}
+	if windows[0].Kind != "five_hour" || windows[0].UsedPercentage == nil || *windows[0].UsedPercentage != 42 {
+		t.Fatalf("primary window = %+v", windows[0])
+	}
+	if windows[1].Kind != "seven_day" || windows[1].ResetAt == nil {
+		t.Fatalf("secondary window = %+v", windows[1])
+	}
+}
+
+func TestParseGoogleQuotaSortsMostUsedAndKeepsModel(t *testing.T) {
+	now := time.Date(2026, 8, 16, 2, 0, 0, 0, time.UTC)
+	windows := parseGoogleQuota([]byte(`{"buckets":[
+		{"modelId":"chat_20706","remainingFraction":0.1},
+		{"modelId":"gemini-flash","remainingFraction":0.8,"remainingAmount":"800","resetTime":"2026-08-17T07:00:00Z","tokenType":"daily"},
+		{"modelId":"gemini-pro","remainingFraction":0.25,"remainingAmount":"25","resetTime":"2026-08-17T07:00:00Z","tokenType":"daily"}
+	]}`), now)
+	if len(windows) != 2 || windows[0].Model != "gemini-pro" {
+		t.Fatalf("windows = %+v", windows)
+	}
+	if windows[0].UsedPercentage == nil || *windows[0].UsedPercentage != 75 || windows[0].Remaining == nil || *windows[0].Remaining != 25 {
+		t.Fatalf("pro window = %+v", windows[0])
+	}
+}
+
+func TestQuotaWindowsForAuthIncludesAntigravityCreditsAndCooldown(t *testing.T) {
+	now := time.Now().UTC()
+	auth := &coreauth.Auth{ID: "ag-test", Provider: "antigravity", ModelStates: map[string]*coreauth.ModelState{
+		"gemini-pro": {Quota: coreauth.QuotaState{Exceeded: true, NextRecoverAt: now.Add(time.Hour)}, UpdatedAt: now},
+	}}
+	coreauth.SetAntigravityCreditsHint(auth.ID, coreauth.AntigravityCreditsHint{Known: true, Available: true, CreditAmount: 12.5, UpdatedAt: now})
+	windows := quotaWindowsForAuth(auth)
+	if len(windows) != 2 {
+		t.Fatalf("windows = %+v", windows)
+	}
+	if windows[1].Kind != "credits" || windows[1].Remaining == nil || *windows[1].Remaining != 12.5 {
+		t.Fatalf("credits = %+v", windows[1])
+	}
+	if windows[0].Kind != "model_cooldown" || windows[0].ResetAt == nil {
+		t.Fatalf("cooldown = %+v", windows[0])
+	}
+}
