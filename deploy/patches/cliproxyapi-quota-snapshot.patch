@@ -0,0 +1,74 @@
+package auth
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestPromptUsageSnapshotsAreRuntimeOnly(t *testing.T) {
+	authID := "prompt-usage-test"
+	ClearPromptUsageSnapshot(authID)
+	t.Cleanup(func() { ClearPromptUsageSnapshot(authID) })
+
+	SetPromptUsageSnapshot(authID, PromptUsageSnapshot{
+		Provider:     "anthropic",
+		Model:        "claude-sonnet",
+		InputTokens:  128,
+		CachedTokens: 64,
+		TotalTokens:  192,
+		ObservedAt:   time.Date(2026, 8, 16, 1, 2, 3, 0, time.UTC),
+		Source:       "provider_usage",
+		LatencyMS:    321,
+	})
+	got, ok := PromptUsageSnapshotForAuth(authID)
+	if !ok || got.InputTokens != 128 || got.CachedTokens != 64 || got.TotalTokens != 192 {
+		t.Fatalf("unexpected prompt usage snapshot: %+v, ok=%v", got, ok)
+	}
+
+	payload, err := json.Marshal(&Auth{ID: authID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(payload), "prompt_usage") {
+		t.Fatalf("runtime prompt usage leaked into persisted auth JSON: %s", payload)
+	}
+
+	ClearPromptUsageSnapshot(authID)
+	if _, ok := PromptUsageSnapshotForAuth(authID); ok {
+		t.Fatal("prompt usage snapshot was not cleared")
+	}
+}
+
+func TestPromptUsageSnapshotRejectsEmptyAndNegativeUsage(t *testing.T) {
+	authID := "prompt-usage-invalid"
+	ClearPromptUsageSnapshot(authID)
+	t.Cleanup(func() { ClearPromptUsageSnapshot(authID) })
+
+	SetPromptUsageSnapshot(authID, PromptUsageSnapshot{})
+	if _, ok := PromptUsageSnapshotForAuth(authID); ok {
+		t.Fatal("empty prompt usage snapshot should not be stored")
+	}
+	SetPromptUsageSnapshot(authID, PromptUsageSnapshot{InputTokens: -1})
+	if _, ok := PromptUsageSnapshotForAuth(authID); ok {
+		t.Fatal("negative prompt usage snapshot should not be stored")
+	}
+}
+
+func TestManagerUpdateClearsPromptUsageWhenDisabled(t *testing.T) {
+	const authID = "prompt-usage-disabled"
+	manager := NewManager(nil, nil, nil)
+	if _, err := manager.Register(context.Background(), &Auth{ID: authID, Provider: "claude"}); err != nil {
+		t.Fatal(err)
+	}
+	SetPromptUsageSnapshot(authID, PromptUsageSnapshot{InputTokens: 12, TotalTokens: 12})
+
+	if _, err := manager.Update(context.Background(), &Auth{ID: authID, Provider: "claude", Disabled: true, Status: StatusDisabled}); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := PromptUsageSnapshotForAuth(authID); ok {
+		t.Fatal("disabling an auth must clear its prompt usage snapshot")
+	}
+}
diff --git a/sdk/cliproxy/auth/quota_snapshot.go b/sdk/cliproxy/auth/quota_snapshot.go
new file mode 100644
index 0000000..04fcc0b
--- /dev/null
+++ b/sdk/cliproxy/auth/quota_snapshot.go
@@ -0,0 +1,105 @@
+package auth
+
+import (
+	"math"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// QuotaWindow is a sanitized usage observation reported by an upstream provider.
+// It intentionally excludes raw headers and credential material.
+type QuotaWindow struct {
+	Kind           string     `json:"kind"`
+	Label          string     `json:"label,omitempty"`
+	Model          string     `json:"model,omitempty"`
+	UsedPercentage *float64   `json:"used_percentage,omitempty"`
+	Remaining      *float64   `json:"remaining,omitempty"`
+	Limit          *float64   `json:"limit,omitempty"`
+	Unit           string     `json:"unit,omitempty"`
+	Status         string     `json:"status,omitempty"`
+	ResetAt        *time.Time `json:"reset_at,omitempty"`
+	ObservedAt     time.Time  `json:"observed_at"`
+	Source         string     `json:"source"`
+}
+
+type quotaHeaderPair struct {
+	kind        string
+	utilization string
+	reset       string
+}
+
+var anthropicQuotaHeaders = []quotaHeaderPair{
+	{kind: "five_hour", utilization: "Anthropic-Ratelimit-Unified-5h-Utilization", reset: "Anthropic-Ratelimit-Unified-5h-Reset"},
+	{kind: "seven_day", utilization: "Anthropic-Ratelimit-Unified-7d-Utilization", reset: "Anthropic-Ratelimit-Unified-7d-Reset"},
+	{kind: "seven_day_sonnet", utilization: "Anthropic-Ratelimit-Unified-7d-Sonnet-Utilization", reset: "Anthropic-Ratelimit-Unified-7d-Sonnet-Reset"},
+	{kind: "seven_day_opus", utilization: "Anthropic-Ratelimit-Unified-7d-Opus-Utilization", reset: "Anthropic-Ratelimit-Unified-7d-Opus-Reset"},
+}
+
+// ParseQuotaWindows extracts only documented UI-relevant quota values from
+// provider responses. Unknown headers are ignored instead of being persisted.
+func ParseQuotaWindows(provider string, headers http.Header, observedAt time.Time) []QuotaWindow {
+	if !strings.EqualFold(strings.TrimSpace(provider), "claude") || len(headers) == 0 {
+		return nil
+	}
+	if observedAt.IsZero() {
+		observedAt = time.Now()
+	}
+	windows := make([]QuotaWindow, 0, len(anthropicQuotaHeaders))
+	for _, pair := range anthropicQuotaHeaders {
+		used, ok := parseQuotaUtilization(headers.Get(pair.utilization))
+		if !ok {
+			continue
+		}
+		windows = append(windows, QuotaWindow{
+			Kind:           pair.kind,
+			UsedPercentage: float64Pointer(used),
+			ResetAt:        parseQuotaReset(headers.Get(pair.reset)),
+			ObservedAt:     observedAt.UTC(),
+			Source:         "provider_response",
+		})
+	}
+	if len(windows) == 0 {
+		return nil
+	}
+	sort.SliceStable(windows, func(i, j int) bool { return windows[i].Kind < windows[j].Kind })
+	return windows
+}
+
+func float64Pointer(value float64) *float64 {
+	return &value
+}
+
+func parseQuotaUtilization(raw string) (float64, bool) {
+	value, err := strconv.ParseFloat(strings.TrimSpace(raw), 64)
+	if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 {
+		return 0, false
+	}
+	// Anthropic reports utilization as a ratio. Accept an already-normalized
+	// percentage as a defensive compatibility fallback.
+	if value <= 1 {
+		value *= 100
+	}
+	if value > 100 {
+		value = 100
+	}
+	return math.Round(value*100) / 100, true
+}
+
+func parseQuotaReset(raw string) *time.Time {
+	value := strings.TrimSpace(raw)
+	if value == "" {
+		return nil
+	}
+	if unix, err := strconv.ParseInt(value, 10, 64); err == nil && unix > 0 {
+		parsed := time.Unix(unix, 0).UTC()
+		return &parsed
+	}
+	if parsed, err := time.Parse(time.RFC3339, value); err == nil {
+		utc := parsed.UTC()
+		return &utc
+	}
+	return nil
+}
