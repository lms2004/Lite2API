LITE2API_API_KEYS=replace-with-a-long-random-gateway-key
LITE2API_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
# Enable only when /admin is restricted by both Nginx and application CIDRs.
LITE2API_ADMIN_AUTO_LOGIN=false
# Append the exact VPN/reverse-proxy egress CIDR only after verifying it.
LITE2API_ADMIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128
LITE2API_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
LITE2API_MAX_BODY_BYTES=8388608
LITE2API_MAX_INFLIGHT_REQUESTS=32
LITE2API_MAX_IDLE_CONNS=128
LITE2API_MAX_IDLE_CONNS_PER_HOST=64
LITE2API_MAX_CONNS_PER_HOST=64
ATOMCODE2API_KEY=replace-with-your-sk-atmc-key
DEEPSEEK_API_KEY=
GROK2API_KEY=
GEMINI_WEB2API_KEY=
CLIPROXYAPI_KEY=replace-with-a-random-oauth-adapter-key
# Separate localhost-only key used by Lite2API to drive OAuth authorization flows.
CLIPROXYAPI_MANAGEMENT_KEY=replace-with-a-different-random-management-key

# UID/GID used by non-root channel containers. bootstrap-channels.sh sets these
# to 10001 for root-run deployments or to the invoking Docker user's IDs.
CHANNEL_RUNTIME_UID=10001
CHANNEL_RUNTIME_GID=10001
# Upgrade only by replacing this with another reviewed immutable digest.
GROK2API_IMAGE=ghcr.io/chenyme/grok2api@sha256:afd5218d68e72e221fb54aba0b6fc78214d008d7ffeb85e865430777114481c0

# Channel bootstrap only. Keep these stable after the first Grok account is stored.
GROK2API_ADMIN_PASSWORD=
GROK2API_JWT_SECRET=
GROK2API_CREDENTIAL_KEY=
