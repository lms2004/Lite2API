{
  "server": {
    "listen": "127.0.0.1:45679",
    "api_key_env": "LITE2API_API_KEYS",
    "admin_token_env": "LITE2API_ADMIN_TOKEN",
    "client_keys_path": "client_keys.v10-preview.json",
    "admin_allowed_cidrs": ["127.0.0.0/8", "::1/128"],
    "trusted_proxy_cidrs": ["127.0.0.0/8", "::1/128"],
    "admin_session_ttl": "30m",
    "max_body_bytes": 8388608,
    "max_inflight_requests": 64,
    "request_read_timeout": "30s",
    "queue_timeout": "30s",
    "response_header_timeout": "30s",
    "stream_idle_timeout": "2m",
    "idle_conn_timeout": "90s",
    "max_idle_conns": 128,
    "max_idle_conns_per_host": 64,
    "max_conns_per_host": 64,
    "failure_threshold": 3,
    "circuit_cooldown": "30s",
    "max_failover_attempts": 3,
    "allow_private_http_upstream": true,
    "request_log_path": "request.v10-preview.log",
    "request_log_max_bytes": 8388608,
    "request_log_backups": 1
  },
  "accounts": [
