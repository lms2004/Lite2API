      "api_key_env": "PREVIEW_FAST_KEY",
      "models": ["gpt-5.6-codex-fast"],
      "capabilities": [{"model":"fast","upstream_model":"gpt-5.6-codex-fast","reasoning_efforts":["auto","low","medium","high"]}],
      "priority": 0,
